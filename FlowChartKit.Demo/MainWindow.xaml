<Window x:Class="FlowChartKit.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="clr-namespace:FlowChartKit.Controls;assembly=FlowChartKit"
        xmlns:local="clr-namespace:FlowChartKit.Demo"
        Title="FlowChartKit 测试台" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen">

    <!-- ViewModel 直接在 XAML 里创建，不再需要代码后置注入 -->
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <DockPanel>
        <!-- 编号/方向由 ViewModel 收集，按钮执行注入的回调，视图代码后置不含任何业务参数 -->
        <Border DockPanel.Dock="Top" Background="#F7F7F7"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="管路编号" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="60" VerticalContentAlignment="Center"
                         Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="方向" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Width="90" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Directions}"
                          DisplayMemberPath="Text"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Direction}" />

                <Button Content="设置流向" Padding="14,4" Margin="12,0,0,0"
                        Command="{Binding ApplyCommand}" />

                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="#555555" />
            </StackPanel>
        </Border>

        <!-- 全部操作（添加/流向/删除/保存/恢复/编辑模式）均在画布控件内完成 -->
        <!-- 设置流向：控件把内置命令经 OneWayToSource 灌入 VM 的 SetDirectionByNumberCommand，VM 只认 ICommand -->
        <fc:DiagramCanvasControl IsEditable="True"
                                 SetDirectionByNumberCommand="{Binding SetDirectionByNumberCommand, Mode=OneWayToSource}" />
    </DockPanel>

</Window>
