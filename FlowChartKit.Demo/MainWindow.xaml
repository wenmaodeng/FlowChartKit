<Window x:Class="FlowChartKit.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="clr-namespace:FlowChartKit.Controls;assembly=FlowChartKit"
        xmlns:vm="clr-namespace:FlowChartKit.ViewModels;assembly=FlowChartKit"
        Title="FlowChartKit 测试台" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
            <fc:FlowNodeControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <fc:PipeControl />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F2F5FB" BorderBrush="#D5DEED"
                BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="编辑模式" IsChecked="{Binding IsEditable}"
                          VerticalAlignment="Center" ToolTip="勾选后可拖动部件与管路端点" />
                <Button Content="保存布局" Command="{Binding SaveCommand}"
                        Margin="20,0,0,0" Padding="12,4" />
                <Button Content="恢复示例" Command="{Binding ResetDemoCommand}"
                        Margin="8,0,0,0" Padding="12,4" />
                <Separator Margin="16,0" />
                <TextBlock Text="部件：" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Palette}"
                          SelectedItem="{Binding SelectedPalette}"
                          DisplayMemberPath="DisplayName" Width="150" />
                <Button Content="添加部件" Command="{Binding AddNodeCommand}"
                        Margin="8,0,0,0" Padding="12,4" />
                <Button Content="添加管路" Command="{Binding AddConnectionCommand}"
                        Margin="8,0,0,0" Padding="12,4"
                        ToolTip="新建一条管路，拖动两端端点吸附到部件端口" />
                <Separator Margin="16,0" />
                <TextBlock Text="管路：" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Diagram.Connections}"
                          SelectedItem="{Binding Diagram.SelectedConnection}"
                          DisplayMemberPath="DisplayName"
                          Width="220" Margin="0,0,6,0"
                          ToolTip="从下拉列表选择管路（除画布点击外的另一种选中方式）" />
                <CheckBox Content="显示编号" IsChecked="{Binding Diagram.ShowNumbers}"
                          VerticalAlignment="Center" Margin="6,0,12,0"
                          ToolTip="在画布上显示管路编号徽章" />
                <TextBlock Text="选中流向：" VerticalAlignment="Center" />
                <Button Content="正向" Command="{Binding Diagram.SetDirectionCommand}"
                        CommandParameter="Forward" Margin="0,0,6,0" Padding="10,4" />
                <Button Content="反向" Command="{Binding Diagram.SetDirectionCommand}"
                        CommandParameter="Reverse" Margin="0,0,6,0" Padding="10,4" />
                <Button Content="停止" Command="{Binding Diagram.SetDirectionCommand}"
                        CommandParameter="None" Margin="0,0,6,0" Padding="10,4" />
                <Button Content="删除" Command="{Binding DeleteSelectedCommand}"
                        Padding="10,4" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="#2F6FAF" />
            </StackPanel>
        </Border>

        <!-- 左侧部件库 -->
        <Border DockPanel.Dock="Left" Width="140" Background="#F4F7FD"
                BorderBrush="#D5DEED" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="部件库" FontWeight="Bold"
                           Margin="10,8,0,4" Foreground="#33517A" />
                <ListBox x:Name="PaletteList" ItemsSource="{Binding Palette}"
                         SelectedItem="{Binding SelectedPalette}"
                         DisplayMemberPath="DisplayName" BorderThickness="0"
                         Background="Transparent" Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseLeftButtonDown"
                                         Handler="PaletteItem_PreviewMouseDown" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧属性面板 -->
        <Border DockPanel.Dock="Right" Width="220" Background="#F4F7FD"
                BorderBrush="#D5DEED" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="属性" FontWeight="Bold"
                           Margin="10,8,0,4" Foreground="#33517A" />
                <Grid Margin="10,4">
                    <!-- 未选中 -->
                    <TextBlock Text="未选中" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#8899AA">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Diagram.SelectedNode}" Value="{x:Null}" />
                                            <Condition Binding="{Binding Diagram.SelectedConnection}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 部件属性 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Diagram.SelectedNode}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称：" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="4,0"
                                     Text="{Binding Diagram.SelectedNode.Label, Mode=OneWay}"
                                     IsReadOnly="True" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="类型：" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="4,0"
                                     Text="{Binding Diagram.SelectedNode.Kind, Mode=OneWay}"
                                     IsReadOnly="True" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="X：" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="4,0"
                                     Text="{Binding Diagram.SelectedNode.X, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Y：" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="4,0"
                                     Text="{Binding Diagram.SelectedNode.Y, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>

                    <!-- 管路属性 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Diagram.SelectedConnection}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="流向：" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="4,0"
                                     Text="{Binding Diagram.SelectedConnection.Direction, Mode=OneWay}"
                                     IsReadOnly="True" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID：" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Margin="4,0"
                                     Text="{Binding Diagram.SelectedConnection.Id, Mode=OneWay}"
                                     IsReadOnly="True" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 中间画布 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Background="#EEF2FA">
            <Canvas x:Name="DiagramCanvas"
                    Width="{Binding Diagram.CanvasWidth}"
                    Height="{Binding Diagram.CanvasHeight}"
                    Background="#FDFEFF"
                    MouseLeftButtonDown="DiagramCanvas_MouseLeftButtonDown">
                <!-- 管路（下层） -->
                <ItemsControl ItemsSource="{Binding Diagram.Connections}"
                              Width="{Binding Diagram.CanvasWidth}"
                              Height="{Binding Diagram.CanvasHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <!-- 部件（上层） -->
                <ItemsControl ItemsSource="{Binding Diagram.Nodes}"
                              Width="{Binding Diagram.CanvasWidth}"
                              Height="{Binding Diagram.CanvasHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Canvas>
        </ScrollViewer>
    </DockPanel>
</Window>
