<UserControl x:Class="FlowChartKit.Controls.DiagramCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="clr-namespace:FlowChartKit.Controls"
             xmlns:vm="clr-namespace:FlowChartKit.ViewModels"
             x:Name="Root"
             ContextMenuOpening="OnContextMenuOpening"
             PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">
    <UserControl.Resources>
        <!-- 隐式数据模板：ViewModel 映射到自绘控件 -->
        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
            <fc:FlowNodeControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <fc:PipeControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextBlockViewModel}">
            <fc:TextBlockItemControl />
        </DataTemplate>
    </UserControl.Resources>

    <!-- 菜单项按右键时的选中状态在代码中动态构建 -->
    <UserControl.ContextMenu>
        <ContextMenu x:Name="CanvasMenu" />
    </UserControl.ContextMenu>

    <ScrollViewer x:Name="CanvasScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto" Background="#EEF2FA">
        <Canvas x:Name="DiagramCanvas"
                Width="{Binding Diagram.CanvasWidth, ElementName=Root}"
                Height="{Binding Diagram.CanvasHeight, ElementName=Root}"
                Background="{Binding Background, ElementName=Root}"
                MouseLeftButtonDown="DiagramCanvas_MouseLeftButtonDown">
            <!-- 管路（下层） -->
            <ItemsControl ItemsSource="{Binding Diagram.Connections, ElementName=Root}"
                          Width="{Binding Diagram.CanvasWidth, ElementName=Root}"
                          Height="{Binding Diagram.CanvasHeight, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="0" />
                        <Setter Property="Canvas.Top" Value="0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <!-- 文本模块（管路之上、部件之下）：左键/右键命中优先级低于部件 -->
            <ItemsControl ItemsSource="{Binding Diagram.Texts, ElementName=Root}"
                          Width="{Binding Diagram.CanvasWidth, ElementName=Root}"
                          Height="{Binding Diagram.CanvasHeight, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <!-- 部件（上层） -->
            <ItemsControl ItemsSource="{Binding Diagram.Nodes, ElementName=Root}"
                          Width="{Binding Diagram.CanvasWidth, ElementName=Root}"
                          Height="{Binding Diagram.CanvasHeight, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <!-- 对齐参考线（捕捉线）：覆盖整个画布、不参与命中测试 -->
            <fc:AlignmentGuideLayer
                Width="{Binding Diagram.CanvasWidth, ElementName=Root}"
                Height="{Binding Diagram.CanvasHeight, ElementName=Root}"
                Canvas.Left="0" Canvas.Top="0"
                Guides="{Binding Diagram.AlignmentGuides, ElementName=Root}" />
        </Canvas>
    </ScrollViewer>
</UserControl>
