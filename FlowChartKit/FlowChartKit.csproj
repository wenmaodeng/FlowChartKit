<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0-windows;net7.0-windows;net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <!-- 允许在非 Windows 环境也能构建 Windows TFM（CI 若换到 Linux 时仍可用） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- net6/7 已 EOL，抑制 NETSDK1138 过期框架警告 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- 库身份与版本：宿主升级依据（SemVer），API 变更时递增并同步 CHANGELOG -->
    <Version>1.2.1</Version>
    <PackageId>FlowChartKit</PackageId>
    <Authors>wenmaodeng</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wenmaodeng/FlowChartKit.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wenmaodeng/FlowChartKit</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>WPF 流程图控件库：部件定义注册表（内置 LED/开关 + 宿主扩展）、管路正交布线、流向动画、布局 JSON 存档（带版本字段）、编辑/运行双模式。</Description>
    <PackageTags>WPF;FlowChart;Diagram;Canvas;MVVM</PackageTags>

    <!-- XML 文档随包分发：公共 API 的注释是宿主接入契约的一部分 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- 包内附加文档：README 为 NuGet.org 包主页，CHANGELOG 为发布说明 -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
