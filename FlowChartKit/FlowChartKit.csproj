<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- 库身份与版本：宿主升级依据（SemVer），API 变更时递增并同步 CHANGELOG -->
    <Version>1.0.0</Version>
    <Authors>wenmaodeng</Authors>
    <RepositoryUrl>https://github.com/wenmaodeng/FlowChartKit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wenmaodeng/FlowChartKit</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Description>WPF 流程图控件库：部件定义注册表（内置 LED/开关 + 宿主扩展）、管路正交布线、流向动画、布局 JSON 存档（带版本字段）、编辑/运行双模式。</Description>
    <PackageTags>WPF;FlowChart;Diagram;Canvas;MVVM</PackageTags>

    <!-- XML 文档随包分发：公共 API 的注释是宿主接入契约的一部分 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
